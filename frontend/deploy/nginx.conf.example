# =============================================================================
# edge_iot_v2 — 前端离线部署 nginx 反向代理参考配置
# =============================================================================
#
# 用途：生产 / 离线环境下，前端不再使用 Vite 开发服务器及其 `server.proxy`
# （见 frontend/vite.config.ts —— proxy 仅在 `vite serve` 生效，不进 build 产物）。
# 生产环境由 nginx 同时承担两件事：
#   1. 托管 `npm run build` 生成的静态资源（frontend/dist/）。
#   2. 把 `/api` 与 `/ws` 反向代理到 Django，路径前缀必须与开发期 Vite proxy
#      完全一致 —— 前端代码始终请求相对路径 `/api`、`/ws`，无需区分环境。
#
# 部署步骤：
#   cd frontend && npm run build           # 产出 dist/
#   将 dist/ 拷贝到 nginx 的 root 目录（下例为 /usr/share/nginx/html）
#   将本文件改名为 nginx.conf（或 include 进 server 块）后重载 nginx
#
# `django` 为 docker-compose 中的服务名；非容器部署请改为实际 host:port。
# =============================================================================

upstream edge_iot_backend {
    server django:8000;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ---- SPA 路由：未命中静态文件时回退到 index.html --------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ---- REST API 反向代理（对齐 Vite dev proxy 的 '/api'） -------------------
    location /api/ {
        proxy_pass http://edge_iot_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # ---- WebSocket 反向代理（对齐 Vite dev proxy 的 '/ws'，需 Upgrade 头） ----
    location /ws/ {
        proxy_pass http://edge_iot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;   # 长连接：避免空闲 WebSocket 被断开
    }

    # ---- 静态资源缓存（带 hash 的 build 产物可长缓存） ------------------------
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}

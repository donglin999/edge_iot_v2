# Copy to edge.env on each edge工控机 and fill in. One file per edge.
#
# EDGE_TOKEN is the one-shot token returned by registering the edge on the
# center:  POST http://<center-ip>:8002/api/fleet/edges/  (see distributed runbook).

EDGE_ID=edge-shanghai-line-1
EDGE_TOKEN=replace-with-token-from-center
CENTER_URL=ws://192.168.1.10:8002/ws/fleet/
EDGE_MQTT_BROKER=mqtt://192.168.1.10:1883

# Unique host port per edge so two edges can share a host: 18088 / 18089.
EDGE_HISTORY_HOST_PORT=18088

# Optional labels shown in the fleet UI.
EDGE_LABELS=line-1,shanghai

# Reduced-config (low-RAM工控机): set false + comment out influxdb service.
EDGE_INFLUX_ENABLED=true

# Offline edge-agent image — self-contained variant of edge-agent/Dockerfile.
#
# The dev image gets the center's Django source from a runtime bind-mount
# (./backend:/opt/backend:ro). An offline工控机 has no repo checkout to mount,
# so this variant BAKES backend/ into /opt/backend at build time. Everything
# else mirrors edge-agent/Dockerfile.
#
# Build context = repo root, target arch = amd64:
#   docker buildx build --platform linux/amd64 \
#     -f deploy/offline/Dockerfile.edge-agent -t edge-iot/edge-agent:offline-amd64 --load .
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/backend-requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r /tmp/backend-requirements.txt

COPY edge-agent/pyproject.toml edge-agent/README.md /app/
COPY edge-agent/src/ /app/src/
RUN pip install --no-cache-dir -e .

# Bake the center backend so `import backend.acquisition` works with no mount.
COPY backend/ /opt/backend/

ENV LOG_LEVEL=INFO \
    DJANGO_SETTINGS_MODULE=control_plane.settings \
    BACKEND_DIR=/opt/backend \
    EDGE_STATE_DB=/var/lib/edge-agent/edge_state.db \
    DJANGO_LOG_DIR=/var/lib/edge-agent/logs \
    PYTHONPATH=/opt/backend:/app/src

RUN mkdir -p /var/lib/edge-agent /var/lib/edge-agent/logs

CMD ["edge-agent"]

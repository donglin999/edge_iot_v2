# 离线生产部署模板。此文件故意不包含可用密钥，直接使用必须失败。
#
# 首次部署：
#   umask 077
#   cp .env.example .env
#   chmod 600 .env
#   openssl rand -hex 32        # 把输出填入 SECRET_KEY（不要发到群聊/工单）
#   vi .env                     # 填写现场值和 InfluxDB token
#   ./load-and-up.sh --env-file .env
#
# .env 必须是普通文件（不能是软链接），权限必须为 0400 或 0600。

# --- Django：生产安全值 ---
DEBUG=False
SECRET_KEY=
# 逗号分隔，必须填现场实际 IP/域名；禁止使用 *。
ALLOWED_HOSTS=

# 默认拒绝通过“连接测试”功能访问私网地址，防止 SSRF。
ALLOW_PRIVATE_NETWORK_TESTS=False
# 仅完全受信的隔离内网/本地测试需要测私网设备时，才可同时设置：
# ALLOW_PRIVATE_NETWORK_TESTS=True
# OFFLINE_PRIVATE_NETWORK_TESTS_ACK=I_UNDERSTAND_PRIVATE_NETWORK_TESTS_DISABLE_SSRF_PROTECTION

# --- 前端 nginx 监听端口（host 网络）---
WEB_PORT=80

# --- 资源调优 ---
CELERY_ACQ_CONCURRENCY=32
CELERY_SHORT_CONCURRENCY=8

# --- Redis（只绑定宿主机 loopback）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
# 仅会停止这里显式列出的旧版采集容器；多个名称用单个空格分隔。
# 默认留空，不会自动停止任何未知容器；部署前核对现场清单后再填写。
LEGACY_CONTAINERS=

# --- InfluxDB（由现场自行运行，本包只连接）---
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_ORG=
INFLUXDB_BUCKET=
INFLUXDB_TOKEN=
# Influx 不可用时的落盘队列；保持 /data 下即可随 app-db 卷持久化。
INFLUX_SPILL_DB_PATH=/data/influx_spill.sqlite3

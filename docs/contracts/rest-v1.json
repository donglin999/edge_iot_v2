    "applies_to": "DRF list actions only; custom actions may return bare arrays or bespoke objects"
  },
  "decimal_wire_rule": "Django DecimalField values are fixed-precision JSON strings, not JSON numbers.",
  "decimal_string_examples": {
    "channel.sampling_rate_hz": "1.25",
    "point.sample_rate_hz": "2.50",
    "point.template_detail.coefficient": "1.2345",
    "task.sample_rate_hz": "3.75"
  },
  "json_value_rules": {
    "data_point_value": "JSONField preserves each stored non-null JSON scalar type; Python None is rejected by the database NOT NULL constraint.",
    "influx_latest_value": "int/float/bool/null pass through; numeric-looking non-JSON strings become float; other strings remain strings.",
    "influx_history_value": "int/float/bool pass through; numeric-looking strings become float; other strings remain strings; null-valued records are omitted.",
    "examples": {
      "data_point_value": {
        "integer": 7,
        "float": 2.5,
        "boolean": true,
        "numeric_string": "3.25",
        "text": "synthetic"
      },
      "influx_latest_value": {
        "integer": 7,
        "float": 2.5,
        "boolean": true,
        "null": null,
        "numeric_string": 3.25,
        "text": "synthetic"
      },
      "influx_history_value": {
        "integer": 7,
        "float": 2.5,
        "boolean": true,
        "numeric_string": 3.25,
        "text": "synthetic"
      },
      "data_point_null_accepted": false
    }
  },

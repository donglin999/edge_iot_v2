  },
  "pagination": {
    "style": "limit-offset",
    "default_limit": 50,
    "maximum_limit": 1000,
    "query_parameters": [
      "limit",
      "offset"
    ],
    "response_keys": [
      "count",
      "next",
      "previous",
      "results"
    ],
    "applies_to": "DRF list actions only; custom actions may return bare arrays or bespoke objects"
  },
  "decimal_wire_rule": "Django DecimalField values are fixed-precision JSON strings, not JSON numbers.",
  "decimal_string_examples": {
    "channel.sampling_rate_hz": "1.25",
    "point.sample_rate_hz": "2.50",
    "point.template_detail.coefficient": "1.2345",
    "task.sample_rate_hz": "3.75"
  },
  "json_value_rules": {
    "data_point_value": "JSONField preserves the stored JSON scalar type.",
    "influx_latest_value": "int/float/bool/null pass through; numeric-looking non-JSON strings become float; other strings remain strings.",
    "influx_history_value": "int/float pass through; numeric-looking strings become float; other strings remain strings."
  },
  "error_families": {
    "drf_validation": {
      "status": 400,
      "top_level_keys": [
        "code",
        "name"
      ],
      "shape": "field -> list[string]"
    },
    "drf_not_found": {
      "status": 404,
      "top_level_keys": [
        "detail"
      ],
      "shape": "detail string/ErrorDetail"
    },
    "detail": {
      "status": [
        400,
        404
      ],
      "top_level_keys": [
        "detail"
      ],
      "shape": "endpoint-specific Chinese detail string"
    },
    "excel_v2": {
      "status": 400,
      "top_level_keys": [
        "created",
        "devices",
        "errors",
        "protocol",
        "updated"
      ],
      "item_keys": [
        "column",
        "kind",
        "message",
        "row",
        "sheet"
      ]
    },
    "excel_scada": {
      "status": 400,
      "top_level_keys": [
        "created",
        "devices",
        "errors",
        "gateway"
      ],
      "item_keys": [
        "column",
        "message",
        "protocol",
        "row"
      ]
    },
    "point_history_upstream_failure": {
      "status": 200,
      "top_level_keys": [
        "count",
        "data",
        "end_time",
        "error",
        "point_code",
        "start_time"
      ],
      "legacy": true
    }
  },
  "known_legacy_defects": [
    {
      "id": "REST-LEGACY-001",
      "behavior": "Errors have several incompatible envelopes instead of one error_code/message/details shape.",
      "migration_rule": "Preserve during shadow comparison; normalize only behind an explicit versioned cutover."
    },
    {
      "id": "REST-LEGACY-002",
      "behavior": "point-history reports InfluxDB failures as HTTP 200 with an error field.",
      "migration_rule": "Do not silently change while clients rely on it; target a coordinated 5xx/error-envelope change."
    },
    {
      "id": "REST-LEGACY-003",
      "behavior": "point-history parses limit with unguarded int(), so malformed values can become HTTP 500.",
      "migration_rule": "Fix before FastAPI parity or encode the corrected 400 as a deliberate contract version."
    },
    {
      "id": "REST-LEGACY-004",
      "behavior": "Global DRF permission is AllowAny; /api/auth is only browsable-session UI and there is no application login flow.",
      "migration_rule": "Authentication/RBAC belongs to M8 and requires coordinated frontend behavior."
    },
    {
      "id": "REST-LEGACY-005",
      "behavior": "Several custom list actions return bare arrays/objects and are not wrapped by global pagination.",
      "migration_rule": "Preserve endpoint-by-endpoint; do not infer pagination from the URL alone."
    }
  ]
}

  "semantic_rules": {
    "v2": "Two display/key header rows; parse English row 2; one device row per device; one point row per point; transactional synchronous upsert; one task per device; errors include kind.",
    "legacy": "Single English header row, multi-protocol wide sheet, ImportJob validation/apply workflow, retained for stored files.",
    "scada": "Single English header row with Chinese comments; shared gateway row plus device/point rows; synchronous transactional upsert; errors include protocol but not sheet/kind.",
    "integer_cells": "Integer-kind fields must remain Excel integers and must not acquire a .0 suffix.",
    "round_trip": "An unchanged export re-imports idempotently; no rows outside the workbook are implicitly deleted."
  },

# 离线部署可选覆盖项 —— 复制为 .env 后按现场修改，再用
#   ./load-and-up.sh --env-file .env
# 不提供 .env 时，compose 里的默认值可直接一键起。

# --- Django ---
# 生产加固：DEBUG=False 时后端会强制校验 SECRET_KEY 不能是默认值。内网隔离机可维持默认。
DEBUG=True
SECRET_KEY=offline-monolith-change-me-please
ALLOWED_HOSTS=*
# 现场 SCADA broker 常是内网私有 IP（如 10.134.14.147）；连接测试 SSRF 防护默认放行私网。
ALLOW_PRIVATE_NETWORK_TESTS=True

# --- 前端 nginx 监听端口（host 网络）。宿主机 :80 被占用时改 8080 等 ---
# 仅「完整模式」(--profile ui / load-and-up.sh --ui) 用得到
WEB_PORT=80

# --- 资源调优 ---
# 采集 worker 线程数：几台设备的工控机 8~32 足够；200 是大规模现场的默认值。
# 调小能显著省内存（这是比关前端更大的一块）。
CELERY_ACQ_CONCURRENCY=200
CELERY_SHORT_CONCURRENCY=8

# --- Redis（本包以 host 网络启动独立 redis,端口独享）。默认 6380:避开宿主机
#     自跑 redis 的常见 6379 冲突(现场实测);再冲突就换任意空闲端口,监听与应用
#     连接一并切换 ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# --- InfluxDB（由生产环境自行运行在宿主机 127.0.0.1:8086，本包只连不启动）---
INFLUXDB_HOST=127.0.0.1
INFLUXDB_PORT=8086
INFLUXDB_ORG=Midea
INFLUXDB_BUCKET=Record
INFLUXDB_TOKEN=tKwtme7RYKb3c9LmBxxVKhWv-MF9TT9XTXFdlm5Q6eU6Q1RS0Ywjk2ND8a1S_CQUcpaNeEHWJwk9NQFnzJZa1g==
# Influx 不可用时的落盘队列；保持 /data 下即可随 app-db 卷跨容器重建保留。
INFLUX_SPILL_DB_PATH=/data/influx_spill.sqlite3

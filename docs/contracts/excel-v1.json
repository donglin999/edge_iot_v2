  "semantic_rules": {
    "v2": "Two display/key header rows; parse English row 2; one device row per device; one point row per point; transactional synchronous upsert; one task per device; errors include kind.",
    "legacy": "Single English header row, multi-protocol wide sheet, ImportJob validation/apply workflow, retained for stored files.",
    "scada": "Single English header row with Chinese comments; shared gateway row plus device/point rows; synchronous transactional upsert; errors include protocol but not sheet/kind.",
    "integer_cells": "Integer-kind fields must remain Excel integers and must not acquire a .0 suffix.",
    "round_trip": "Generated workbooks parse again entirely in memory; an unchanged export re-imports idempotently and no rows outside the workbook are implicitly deleted.",
    "credential_values": "The fixture records schema metadata only. Secret defaults are empty and examples are null/placeholders; tests use an unmistakably synthetic in-memory sentinel to prove plaintext round-trip behavior without committing a usable credential."
  },
  "known_legacy_defects": [
    {
      "id": "EXCEL-LEGACY-001",
      "behavior": "MQTT, OPC UA and SCADA exports can contain plaintext credentials.",
      "migration_rule": "Contract fixtures use synthetic values only; implement secret redaction/keep-existing semantics as an explicit security change."
    },
    {
      "id": "EXCEL-LEGACY-002",
      "behavior": "v2, SCADA and legacy use incompatible headers, workflows and row-error item shapes.",
      "migration_rule": "Keep format detection explicit; never route a workbook to a parser by filename alone."
    },
    {
      "id": "EXCEL-LEGACY-003",
      "behavior": "Legacy is called a 40-column format, but its schema is registry-driven and the exact field count can drift.",
      "migration_rule": "The executable field-spec snapshot, not the nickname, is normative."
    }
  ]
}

# Offline edge-agent image — self-contained variant of edge-agent/Dockerfile.
#
# Two offline-critical differences vs the dev image:
#   1. Python deps install from a HOST-built amd64 wheelhouse (--no-index), so
#      the QEMU cross-build does ZERO network downloads (the in-container PyPI
#      download is ~13 kB/s under emulation — see XIU-128 checkpoint).
#   2. backend/ is BAKED into /opt/backend (the dev image bind-mounts it).
#
# Build context = repo ROOT (needs deploy/offline/wheelhouse + backend/ + edge-agent/):
#   docker buildx build --platform linux/amd64 \
#     -f deploy/offline/Dockerfile.edge-agent -t edge-iot/edge-agent:offline-amd64 --load .
FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai

WORKDIR /app

COPY deploy/offline/wheelhouse /wheels

# backend runtime deps + edge-agent's own deps (websockets/aiohttp/aiomqtt are
# in the wheelhouse) — all offline.
COPY backend/requirements.txt /tmp/backend-requirements.txt
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r /tmp/backend-requirements.txt

# Edge-agent's own runtime deps (websockets/aiohttp/aiomqtt + transitive) from
# the wheelhouse. We deliberately do NOT `pip install -e .`: an editable/PEP517
# build pulls build deps from an index, which --no-index blocks. Instead the
# package runs straight from source via `python -m edge_agent` (the console
# script `edge-agent` maps to edge_agent.__main__:main; PYTHONPATH=/app/src).
COPY edge-agent/pyproject.toml edge-agent/README.md /app/
COPY edge-agent/src/ /app/src/
RUN pip install --no-cache-dir --no-index --find-links=/wheels \
        websockets aiohttp aiomqtt \
    && rm -rf /wheels

# Bake the center backend so `import backend.acquisition` works with no mount.
COPY backend/ /opt/backend/

ENV LOG_LEVEL=INFO \
    DJANGO_SETTINGS_MODULE=control_plane.settings \
    BACKEND_DIR=/opt/backend \
    EDGE_STATE_DB=/var/lib/edge-agent/edge_state.db \
    DJANGO_LOG_DIR=/var/lib/edge-agent/logs \
    PYTHONPATH=/opt/backend:/app/src

RUN mkdir -p /var/lib/edge-agent /var/lib/edge-agent/logs

CMD ["python", "-m", "edge_agent"]

  "known_legacy_defects": [
    {
      "id": "REST-LEGACY-001",
      "behavior": "Errors have several incompatible envelopes instead of one error_code/message/details shape.",
      "migration_rule": "Preserve during shadow comparison; normalize only behind an explicit versioned cutover."
    },
    {
      "id": "REST-LEGACY-002",
      "behavior": "point-history reports InfluxDB failures as HTTP 200 with an error field.",
      "migration_rule": "Do not silently change while clients rely on it; target a coordinated 5xx/error-envelope change."
    },
    {
      "id": "REST-LEGACY-003",
      "behavior": "point-history parses limit with unguarded int(), so malformed values can become HTTP 500.",
      "migration_rule": "Fix before FastAPI parity or encode the corrected 400 as a deliberate contract version."
    },
    {
      "id": "REST-LEGACY-004",
      "behavior": "Global DRF permission is AllowAny; /api/auth is only browsable-session UI and there is no application login flow.",
      "migration_rule": "Authentication/RBAC belongs to M8 and requires coordinated frontend behavior."
    },
    {
      "id": "REST-LEGACY-005",
      "behavior": "Several custom list actions return bare arrays/objects and are not wrapped by global pagination.",
      "migration_rule": "Preserve endpoint-by-endpoint; do not infer pagination from the URL alone."
    },
    {
      "id": "REST-LEGACY-006",
      "behavior": "The generic /api/config/tasks/ list silently ignores site_code while /api/config/tasks/overview/ applies it.",
      "migration_rule": "Add filtering only as a coordinated behavior change; shadow comparison must account for the current cross-site list."
    },
    {
      "id": "REST-LEGACY-007",
      "behavior": "A device connection-test worker failure returns HTTP 200 with success=false instead of a non-2xx status.",
      "migration_rule": "Keep the boolean failure contract until clients switch to a versioned status/error model."
    },
    {
      "id": "REST-LEGACY-008",
      "behavior": "Task-control and acquisition-session start/stop endpoints expose two different status codes and response envelopes for overlapping operations.",
      "migration_rule": "Do not merge the two control surfaces without an explicit caller migration and rollback window."
    }
  ]
}
